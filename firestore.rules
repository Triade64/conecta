rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Base inicial: somente usuários autenticados poderão acessar os dados.
    // As permissões por setor serão refinadas na implementação da autenticação.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

