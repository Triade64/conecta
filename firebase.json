{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebaserc.example",
      "**/.*",
      "**/node_modules/**",
      "backend/**",
      "database/**",
      "docs/**",
      "src/**",
      "data/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{"key": "Cache-Control", "value": "public,max-age=3600"}]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}

