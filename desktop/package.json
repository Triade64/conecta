{
  "name": "conecta-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "Conecta da Tríade para Windows",
  "author": "Tríade",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.triade.conecta",
    "productName": "Conecta",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "attention.cjs",
      "notifications.cjs",
      "updater.cjs",
      "downloads.cjs",
      "assets/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "Conecta-Setup-${version}-${arch}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Triade64",
        "repo": "conecta",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
